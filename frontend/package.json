    "@phosphor-icons/react": "^2.1.10",
    "@react-aria/i18n": "3.13.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.30",
