# /opt/leonit/.env — единственное место с секретами стенда. Создаётся
# bootstrap-server.sh; пайплайн деплоя только дописывает IMAGE_TAG.

# --- домен и адреса ---
# DOMAIN — основной: по нему Caddy выпускает сертификат, деплой проверяет health.
# DOMAIN_ALIASES — дополнительные хосты через пробел: www-вариант (Caddy
# перенаправит на основной) и старый <ip-через-дефисы>.sslip.io, чтобы
# разосланные ссылки продолжали открываться. Значение с пробелами — в кавычках:
# deploy.sh читает этот файл как shell. После смены — docker compose up -d.
DOMAIN=leon-it.tech
DOMAIN_ALIASES="www.leon-it.tech 89-23-117-80.sslip.io"
ACME_EMAIL=admin@leon-it.tech
PUBLIC_URL=https://leon-it.tech
CORS_ORIGINS=["https://leon-it.tech","https://www.leon-it.tech","https://89-23-117-80.sslip.io"]

# --- база ---
POSTGRES_DB=leonit
POSTGRES_USER=leonit
POSTGRES_PASSWORD=<generated>

# --- приложение ---
JWT_SECRET=<generated, 64 hex>
# Fernet-ключ для секретов интеграций в БД; deploy.sh создаст, если нет.
DATA_ENCRYPTION_KEY=<generated, urlsafe base64 32 bytes>
METRICS_TOKEN=<generated>
LOG_LEVEL=INFO
# Huntflow: auto — реальный клиент по токену из кабинета, демо без токена;
# fake — только фикстуры; real — демо запрещено.
HUNTFLOW_MODE=auto

# --- HH.ru (без ключей — демо-режим на фикстурах) ---
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_REDIRECT_URL=https://leon-it.tech/api/integrations/hh/callback
# HH_SYNC_INTERVAL_MINUTES=10

# --- образы (дописывает деплой) ---
IMAGE_TAG=latest
