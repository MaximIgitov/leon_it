# /opt/leonit/.env — единственное место с секретами стенда. Создаётся
# bootstrap-server.sh; пайплайн деплоя только дописывает IMAGE_TAG.

# --- домен и адреса ---
DOMAIN=89-23-117-80.sslip.io
ACME_EMAIL=admin@example.com
PUBLIC_URL=https://89-23-117-80.sslip.io
CORS_ORIGINS=["https://89-23-117-80.sslip.io"]

# --- база ---
POSTGRES_DB=leonit
POSTGRES_USER=leonit
POSTGRES_PASSWORD=<generated>

# --- приложение ---
JWT_SECRET=<generated, 64 hex>
# Fernet-ключ для секретов интеграций в БД; deploy.sh создаст, если нет.
DATA_ENCRYPTION_KEY=<generated, urlsafe base64 32 bytes>
METRICS_TOKEN=<generated>
LOG_LEVEL=INFO

# --- HH.ru (без ключей — демо-режим на фикстурах) ---
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_REDIRECT_URL=https://89-23-117-80.sslip.io/api/integrations/hh/callback
# HH_SYNC_INTERVAL_MINUTES=10

# --- образы (дописывает деплой) ---
IMAGE_TAG=latest
